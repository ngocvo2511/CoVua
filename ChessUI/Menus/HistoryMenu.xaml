<UserControl x:Class="ChessUI.Menus.HistoryMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:ChessUI.Menus"
             xmlns:UI="clr-namespace:ChessUI"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1200">
    <Grid>
        <Border Background="#80000000" BorderThickness="0" CornerRadius="10">
            <Border Style="{StaticResource BorderStyle1}" Padding="10" Height="500" Width="450">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="6*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="CloseButton"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Background="Transparent"
                     Foreground="Black"
                     BorderThickness="0"
                     Width="30" Height="30" 
                     Margin="0,10,10,0"
                     Click="CloseButton_Click">
                        <iconPacks:PackIconMaterial Kind="Close" Height="20" Width="20"/>
                    </Button>
                    <TextBlock Text="Lịch sử chơi" 
                        Style="{StaticResource TextStyle1}" 
                        FontSize="35"/>
                    <ScrollViewer Grid.Row="1">
                        <ListBox x:Name="HistoryList"
                          ItemsSource="{Binding Histories}"
                          Background="Transparent"
                          HorizontalContentAlignment="Stretch"                    
                          BorderThickness="0"
                          SelectionChanged="HistoryList_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border 
                                     Padding="10"
                                     HorizontalAlignment="Stretch"
                                     BorderThickness="1"
                                     CornerRadius="10"
                                     BorderBrush="{StaticResource TextColor}"
                                     Background="#FFF">
                                        <DockPanel LastChildFill="True">
                                            <!-- Image avatar -->
                                            <Image Source="{Binding ImagePath}"
                                            Width="60" Height="60"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            DockPanel.Dock="Left"/>

                                            <!-- Info -->
                                            <StackPanel>
                                                <TextBlock Text="{Binding PlayTime}"
                                FontWeight="Bold"
                                FontSize="14"
                                HorizontalAlignment="Stretch"
                                Foreground="#374151"/>
                                                <TextBlock Text="{Binding GameMode}"
                                Margin="0,5,0,0"
                                FontSize="16"
                                HorizontalAlignment="Stretch"                    
                                Foreground="#111827"/>
                                                <TextBlock Text="{Binding Winner}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="DarkRed"
                                HorizontalAlignment="Stretch"                    
                                Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Reason}"
                                FontStyle="Italic"
                                Foreground="#6B7280"
                                FontSize="13"
                                HorizontalAlignment="Stretch"
                                Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
        <Border x:Name="ConfirmationDialogContainer" Background="#80000000" Visibility="Collapsed" 
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             BorderThickness="0" CornerRadius="10">
            <UI:SaveLoadConfirm x:Name="ConfirmationControl" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
